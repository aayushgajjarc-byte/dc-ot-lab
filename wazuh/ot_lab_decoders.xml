<!--
  OT security lab: custom decoders (Wazuh 4.14).
  Install to /var/ossec/etc/decoders/ on the manager.

  Sources
    fw-l1        iptables NFLOG lines (ulogd2 -> rsyslog, tag "fw-l1-nflog"), prefixes MODBUS-BLOCK / FW-DENY;
                 Modbus blocks carry FC=<code>:<name>, e.g. FC=08/0001:restart-comms (field modbus_fc)
    diode-recv   DMZ mirror receiver log (journald, via the Wazuh agent)
    diode-send   historian sender log (journald, via rsyslog)
    grafana-log  /var/log/grafana/grafana.log (Wazuh agent on grafana-it)
  pfSense sends no hostname, so filterlog and GUI logins use the pf-nohost and pf-gui-nohost decoders below.
  Also: openplc (web UI), node-red (audit), ot-fim (file integrity and account changes on OT hosts).

  How the field decoders are written (checked against the Wazuh 4.14 source, decoders/decoder.c):
  under one parent, only the FIRST child without a <prematch> is used, and if its regex fails decoding stops.
  The exception is "sibling" decoders: children with the SAME name are all tried in turn, each adding its fields.
  So every parent below has ONE group of same-named children, one small regex per field group, and no optional
  capture groups (an unmatched group ends the field list early).
-->

<!-- ===== fw-l1: lines like
Nov 10 12:00:01 fw-l1 fw-l1-nflog: Nov 10 12:00:01 fw-l1 MODBUS-BLOCK: IN=eth1 OUT=eth0 MAC=.. SRC=192.168.72.10 DST=192.168.71.10 LEN=60 .. PROTO=TCP SPT=49324 DPT=502 WINDOW=63 RES=0x00 ACK PSH URGP=0
===== -->
<decoder name="ot-fw">
  <program_name>^fw-l1-nflog</program_name>
</decoder>

<decoder name="ot-fw-fields">
  <parent>ot-fw</parent>
  <regex type="pcre2">(MODBUS-BLOCK|FW-DENY):</regex>
  <order>action</order>
</decoder>

<decoder name="ot-fw-fields">
  <parent>ot-fw</parent>
  <regex type="pcre2">MODBUS-BLOCK: FC=(\S+)</regex>
  <order>modbus_fc</order>
</decoder>

<decoder name="ot-fw-fields">
  <parent>ot-fw</parent>
  <regex type="pcre2"> SRC=(\S+) DST=(\S+) </regex>
  <order>srcip,dstip</order>
</decoder>

<decoder name="ot-fw-fields">
  <parent>ot-fw</parent>
  <regex type="pcre2"> PROTO=(\w+)</regex>
  <order>protocol</order>
</decoder>

<decoder name="ot-fw-fields">
  <parent>ot-fw</parent>
  <regex type="pcre2"> SPT=(\d+) DPT=(\d+)</regex>
  <order>srcport,dstport</order>
</decoder>

<!-- ===== diode receiver (mirror-dmz). Journald lines look like
Nov 10 20:12:18 mirror-dmz diode-recv[321]: 2026-11-10 20:12:18 REJECTED datagram from 192.168.74.77: bad mac
===== -->
<decoder name="diode-recv">
  <prematch type="pcre2">^\d{4}-\d\d-\d\d \d\d:\d\d:\d\d (?:REJECTED datagram|sequence gap|sequence went backwards|mirror write failed|stats write failed|summary:|first valid datagram|diode_recv:)</prematch>
</decoder>

<decoder name="diode-recv-fields">
  <parent>diode-recv</parent>
  <regex type="pcre2">REJECTED datagram from (\S+): (.+)$</regex>
  <order>srcip,reason</order>
</decoder>

<decoder name="diode-recv-fields">
  <parent>diode-recv</parent>
  <regex type="pcre2">sequence gap: expected (\d+) got (\d+) \((\d+) lost\)</regex>
  <order>expected_seq,got_seq,lost</order>
</decoder>

<!-- ===== diode sender (influx-l3). Lines like
Nov 10 20:12:18 influx-l3 diode-send[1303]: 2026-11-10 20:12:18 send failed ([Errno 101] Network is unreachable)
===== -->
<decoder name="diode-send">
  <prematch type="pcre2">^\d{4}-\d\d-\d\d \d\d:\d\d:\d\d (?:historian query failed|send failed|skipping \d+ s of old data|sent \d+ points|diode_send:)</prematch>
</decoder>

<!-- ===== Grafana (logfmt), e.g.
logger=context userId=0 orgId=0 uname= t=2026-11-10T20:00:00.123456789Z level=warn msg="Invalid username or password" error="..." remote_addr=192.168.75.50
===== -->
<decoder name="grafana-log">
  <prematch type="pcre2">^logger=\S+ </prematch>
</decoder>

<decoder name="grafana-log-addr">
  <parent>grafana-log</parent>
  <regex type="pcre2">remote_addr=(\S+)</regex>
  <order>srcip</order>
</decoder>

<!-- ===== pfSense filterlog WITHOUT a hostname =====
pfSense forwards BSD syslog as "Nov 11 09:05:40 filterlog[33080]: 1,96,,..." (no hostname). Wazuh's pre-decoder
then takes "filterlog[33080]:" as the hostname, the built-in "pf" decoder never matches, and the decoder sees
only the CSV body. These decoders match that CSV body directly (IPv4 only).
Fields: rule,subrule,anchor,tracker,interface,reason,action,direction,4,tos,ecn,ttl,id,offset,flags,protoid,proto,length,src,dst[,sport,dport]
===== -->
<decoder name="pf-nohost">
  <prematch type="pcre2">^(?:filterlog\[\d+\]:\s*)?\d+,\d*,[^,]*,\d+,[\w.]+,\w+,(?:block|pass),(?:in|out),4,</prematch>
</decoder>

<decoder name="pf-nohost-fields">
  <parent>pf-nohost</parent>
  <regex type="pcre2">^(?:filterlog\[\d+\]:\s*)?\d+,\d*,[^,]*,\d+,([\w.]+),\w+,(block|pass),(in|out),4,(?:[^,]*,){6}\d+,(\w+),\d+,([\d.]+),([\d.]+)</regex>
  <order>interface,action,direction,protocol,srcip,dstip</order>
</decoder>

<decoder name="pf-nohost-fields">
  <parent>pf-nohost</parent>
  <regex type="pcre2">,4,(?:[^,]*,){6}\d+,(?:tcp|udp),\d+,[\d.]+,[\d.]+,(\d+),(\d+)</regex>
  <order>srcport,dstport</order>
</decoder>

<!-- ===== OpenPLC web UI (journal identifier "openplc", set by setup_log_forwarding.sh plc). Werkzeug request lines:
[INFO] 17:20:01 - 192.168.73.1 - - [14/Nov/2026 17:20:01] "POST /login HTTP/1.1" 302 -
OpenPLC answers a good login with 302 (redirect to the dashboard) and a bad one with 200 (login page again). ===== -->
<decoder name="openplc">
  <program_name>^openplc</program_name>
</decoder>

<decoder name="openplc-web">
  <parent>openplc</parent>
  <regex type="pcre2">(\d{1,3}(?:\.\d{1,3}){3}) - - \[[^\]]*\] "(\w+) (\S+) HTTP/[\d.]+" (\d{3})</regex>
  <order>srcip,method,url,status</order>
</decoder>

<!-- ===== Node-RED (journal identifier "node-red"). Audit lines (logging.console.audit = true):
14 Nov 17:20:01 - [audit] {"event":"flows.set","type":"full","version":"v2","user":{"username":"admin"},"path":"/flows","ip":"192.168.72.1"}
Sibling decoders (same name) each pick one field, because the keys are not always present. ===== -->
<decoder name="node-red">
  <program_name>^node-red</program_name>
</decoder>

<decoder name="node-red-audit">
  <parent>node-red</parent>
  <regex type="pcre2">\[audit\] \{"event":"([^"]+)"</regex>
  <order>audit_event</order>
</decoder>

<decoder name="node-red-audit">
  <parent>node-red</parent>
  <regex type="pcre2">\[audit\] .*"ip":"(?:::ffff:)?([^"]+)"</regex>
  <order>srcip</order>
</decoder>

<decoder name="node-red-audit">
  <parent>node-red</parent>
  <regex type="pcre2">\[audit\] .*"username":"([^"]*)"</regex>
  <order>dstuser</order>
</decoder>

<!-- ===== ot-fim (inotify watcher on OT hosts, installed by setup_log_forwarding.sh). Two kinds of line:
FIM change path=/root/fw_ot.sh event=CLOSE_WRITE,CLOSE sha256=3f2a... mode=755 owner=root:root
FIM delete path=/etc/diode/send.env event=DELETE
ACCOUNT user-added name=testfim uid=1001 gid=1001 home=/home/testfim shell=/bin/sh
ACCOUNT password-changed name=root
ACCOUNT group-members-changed name=sudo added=testfim removed=- ===== -->
<decoder name="ot-fim">
  <program_name>^ot-fim</program_name>
</decoder>

<decoder name="ot-fim-fields">
  <parent>ot-fim</parent>
  <regex type="pcre2">^FIM (change|delete) path=(\S+) event=(\S+)</regex>
  <order>fim_action,fim_path,fim_event</order>
</decoder>

<decoder name="ot-fim-fields">
  <parent>ot-fim</parent>
  <regex type="pcre2"> sha256=(\S+) mode=(\S+) owner=(\S+)</regex>
  <order>fim_sha256,fim_mode,fim_owner</order>
</decoder>

<decoder name="ot-fim-fields">
  <parent>ot-fim</parent>
  <regex type="pcre2">^ACCOUNT (\S+) name=(\S+)</regex>
  <order>account_event,account_name</order>
</decoder>

<decoder name="ot-fim-fields">
  <parent>ot-fim</parent>
  <regex type="pcre2">^ACCOUNT \S+ name=\S+ (.+)$</regex>
  <order>account_detail</order>
</decoder>

<!-- ===== pfSense web GUI logins without a hostname (same pre-decoder problem as filterlog):
Nov 14 10:00:00 php-fpm[412]: /index.php: Successful login for user 'admin' from: 192.168.73.1 (Local Database)
Nov 14 10:00:00 php-fpm[412]: /index.php: webConfigurator authentication error for user 'admin' from: 192.168.73.1 ===== -->
<decoder name="pf-gui-nohost">
  <prematch type="pcre2">^(?:php-fpm\[\d+\]:\s*)?/\S+\.php: </prematch>
</decoder>

<decoder name="pf-gui-nohost-user">
  <parent>pf-gui-nohost</parent>
  <regex type="pcre2">for user '([^']*)' from: ([\d.]+)</regex>
  <order>dstuser,srcip</order>
</decoder>

