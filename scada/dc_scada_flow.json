 {
  "id": "fn_all",
  "type": "function",
  "z": "dc_tab",
  "name": "run all (spaced 2.5 s)",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 400,
  "y": 600,
  "wires": [
   [
    "fn_probe"
   ]
  ],
  "func": "const names = [\"FC03 read holding regs\", \"FC06 write HR 50\", \"FC17 report slave ID\", \"FC43 read device ID\", \"FC08/0001 restart comms\", \"FC08/0004 force listen-only\", \"FC08/000A clear counters\"];\nnames.forEach((n, i) => setTimeout(() => node.send({ payload: n }), i * 2500));\nreturn null;"
 },
 {
  "id": "fn_probe",
  "type": "function",
  "z": "dc_tab",
  "name": "raw Modbus probe",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "x": 620,
  "y": 640,
  "libs": [
   {
    "var": "net",
    "module": "net"
   }
  ],
  "wires": [
   [
    "fn_log"
   ]
  ],
  "func": "// Sends ONE raw Modbus/TCP request on a NEW TCP connection and reports whether the PLC answered.\n// A packet dropped by the firewall shows up as no reply (timeout).\nconst HOST = '192.168.71.10', PORT = 502, TIMEOUT = 2000;\nconst H = (...v) => v.flatMap(x => [x >> 8, x & 255]);\nconst TESTS = {\n  'FC03 read holding regs':       { pdu: [0x03, ...H(0, 6)],     expect: 'allow' },\n  'FC06 write HR 50':             { pdu: [0x06, ...H(50, 1234)], expect: 'allow' },\n  'FC17 report slave ID':         { pdu: [0x11],                 expect: 'block' },\n  'FC43 read device ID':          { pdu: [0x2b, 0x0e, 0x01, 0x00], expect: 'block' },\n  'FC08/0001 restart comms':      { pdu: [0x08, ...H(1, 0)],     expect: 'block' },\n  'FC08/0004 force listen-only':  { pdu: [0x08, ...H(4, 0)],     expect: 'block' },\n  'FC08/000A clear counters':     { pdu: [0x08, ...H(10, 0)],    expect: 'block' }\n};\nconst name = msg.payload, t = TESTS[name];\nif (!t) { node.warn('unknown test ' + name); return null; }\nconst tid = Math.floor(Math.random() * 65535);\nconst frame = Buffer.from([...H(tid, 0, t.pdu.length + 1), 1, ...t.pdu]);\nconst s = new net.Socket();\nlet finished = false;\nconst finish = (got, detail) => {\n  if (finished) return; finished = true; s.destroy();\n  const ok = (t.expect === 'allow') === (got === 'reply');\n  node.send({ payload: { time: new Date().toLocaleTimeString(), command: name, policy: t.expect === 'allow' ? 'allow' : 'block',\n                         result: got === 'reply' ? 'PLC replied' : 'no reply (dropped)', detail: detail || '', verdict: ok ? 'OK' : 'UNEXPECTED' } });\n};\ns.setTimeout(TIMEOUT);\ns.on('connect', () => s.write(frame));\ns.on('data', () => finish('reply'));\ns.on('timeout', () => finish('dropped', 'timeout'));\ns.on('error', e => finish('dropped', e.code));\ns.connect(PORT, HOST);\nreturn null;"
 },
 {
  "id": "fn_log",
  "type": "function",
  "z": "dc_tab",
