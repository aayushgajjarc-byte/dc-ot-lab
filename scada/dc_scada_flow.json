   [
    "w_il"
   ]
  ],
  "func": "const c = msg.payload;\nif (!Array.isArray(c) || c.length < 7) { node.warn('unexpected coil payload'); return null; }\nconst [warn, crit, office, running, manual, hvacCmd, interlock] = c;\nconst state = crit ? 'CRITICAL' : (warn ? 'WARNING' : 'NORMAL');\nconst hv = interlock ? 'FORCED ON' : (running ? 'RUNNING' : ((manual && !hvacCmd) ? 'OFF (manual)' : 'IDLE'));\nconst sync = (key, v) => { const l = context.get(key); context.set(key, v); return l !== v ? { payload: v } : null; };\nreturn [ { payload: state }, { payload: office ? 'Office hrs' : 'After hrs' }, { payload: hv },\n         sync('lastManual', !!manual), sync('lastHvac', !!hvacCmd), { payload: interlock ? 'ACTIVE' : 'off' } ];"
 },
