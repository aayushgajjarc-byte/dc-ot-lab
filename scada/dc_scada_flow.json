 {
  "id": "fn_hist",
  "type": "function",
  "z": "dc_tab",
  "name": "telemetry -> points",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 400,
  "y": 800,
  "wires": [
   [
    "wr_hist"
   ]
  ],
  "func": "const r = msg.payload;\nif (!Array.isArray(r) || r.length < 21) return null;\nconst ts = Math.floor(Date.now() / 1000) * 1000;        // 1 s aligned, ms precision\nconst f = v => v / 10;\nconst temp = (room, v) => ({ measurement: 'dc_temp', tags: { room }, fields: { value: f(v) }, timestamp: ts });\nconst pwr = (room, kind, v) => ({ measurement: 'dc_power', tags: { room, kind }, fields: { kw: f(v) }, timestamp: ts });\nmsg.payload = [\n  temp('outside', r[1]), temp('admin', r[2]), temp('reception', r[3]), temp('server', r[4]),\n  pwr('admin', 'load', r[6]), pwr('reception', 'load', r[7]), pwr('server', 'load', r[8]),\n  pwr('admin', 'cooling_thermal', r[9]), pwr('reception', 'cooling_thermal', r[10]), pwr('server', 'cooling_thermal', r[11]),\n  pwr('server', 'hvac_electrical', r[12]), pwr('facility', 'total', r[5]),\n  { measurement: 'dc_state', fields: { sim_minute: r[0], server_setpoint: f(r[13]) }, timestamp: ts }\n];\nreturn msg;"
 },
