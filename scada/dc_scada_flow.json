    "w_sp"
   ],
   [
    "u_slider"
   ]
  ],
  "func": "const r = msg.payload;\nif (!Array.isArray(r) || r.length < 21) { node.warn('unexpected HR payload'); return null; }\nconst hh = String(Math.floor(r[0] / 60)).padStart(2, '0'), mm = String(r[0] % 60).padStart(2, '0');\nconst t = (v, topic) => ({ payload: v / 10, topic });\nconst kw = v => ({ payload: (v / 10).toFixed(1) + ' kW' });\n// slider follows the PLC's commanded setpoint, but only when it changes (no fighting the operator)\nconst cmd = r[20] === 0 ? 22 : r[20] / 10;\nconst last = context.get('lastCmd');\ncontext.set('lastCmd', cmd);\nreturn [\n  { payload: hh + ':' + mm }, t(r[1], 'Outside'), t(r[2], 'Admin'), t(r[3], 'Reception'), t(r[4], 'Server'),\n  kw(r[5]), kw(r[6]), kw(r[7]), kw(r[8]), kw(r[11]), kw(r[12]),\n  { payload: (r[13] / 10).toFixed(1) + ' °C' },\n  (last !== cmd ? { payload: cmd } : null)\n];"
 },
 {
  "id": "fn_alarm",
  "type": "function",
  "z": "dc_tab",
  "name": "coil status",
  "outputs": 6,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
