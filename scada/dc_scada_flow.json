 {
  "id": "fn_scale",
  "type": "function",
  "z": "dc_tab",
  "name": "scale registers",
  "outputs": 13,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 380,
  "y": 300,
  "wires": [
   [
    "w_clock"
   ],
   [
    "w_tout",
    "c_chart"
   ],
   [
    "w_adm",
    "c_chart"
   ],
   [
    "w_rec",
    "c_chart"
   ],
   [
    "w_srv",
    "c_chart"
   ],
   [
    "w_pwr"
   ],
   [
    "w_la"
   ],
