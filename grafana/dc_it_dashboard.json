            "type": "influxdb",
            "uid": "dmz-mirror"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"dc_temp\" and r.room == \"server\" and r._field == \"value\")\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: float(v: int(v: now()) - int(v: r._time)) / 1000000000.0}))\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
