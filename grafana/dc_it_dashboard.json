    {
      "id": 10,
      "type": "stat",
      "title": "Link status",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 3,
        "h": 4
      },
      "datasource": {
        "type": "influxdb",
        "uid": "dmz-mirror"
      },
      "description": "LIVE when the receiver wrote its statistics in the last 15 seconds.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "dmz-mirror"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"diode_stats\" and r._field == \"received\")\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: float(v: int(v: now()) - int(v: r._time)) / 1000000000.0}))\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 15,
                "result": {
                  "text": "LIVE",
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 15,
                "to": 100000000,
                "result": {
                  "text": "STALE",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "NO DATA",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
