                        "text": "auto",
                        "color": "#2d3a45",
                        "index": 0
                      },
                      "1": {
                        "text": "MANUAL",
                        "color": "purple",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "office_hours"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "after hrs",
                        "color": "#2d3a45",
                        "index": 0
                      },
                      "1": {
                        "text": "office hrs",
                        "color": "blue",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "rowHeight": 0.85,
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
