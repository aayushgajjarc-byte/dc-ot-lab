    {
      "id": 19,
      "type": "timeseries",
      "title": "Datagrams per 30 s",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "dmz-mirror"
      },
      "description": "Received, lost and rejected datagrams in each 30 s window (counters are differenced; receiver restarts are handled).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "dmz-mirror"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"diode_stats\" and (r._field == \"received\" or r._field == \"lost\" or r._field == \"rejected\"))\n  |> aggregateWindow(every: 30s, fn: last, createEmpty: false)\n  |> difference(nonNegative: true)\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> sort(columns: [\"_time\"])\n  |> keep(columns: [\"_time\", \"received\", \"lost\", \"rejected\"])\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "received"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
