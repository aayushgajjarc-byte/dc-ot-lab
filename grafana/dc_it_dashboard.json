      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "dmz-mirror"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -2m)\n  |> filter(fn: (r) => r._measurement == \"dc_temp\" and r.room == \"outside\" and r._field == \"value\")\n  |> last()\n"
